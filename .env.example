# MongoDB bağlantı adresi (zorunlu)
MONGODB_URI=mongodb://user:password@host:27017/ndmr

# JWT imzalama anahtarı (zorunlu — rastgele uzun bir değer girin)
JWT_SECRET=change-me-to-a-long-random-string

# İlk kurulumda otomatik oluşturulacak admin hesabı
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Uygulama portu
PORT=3000

# Sitemap ve SEO için tam site adresi
SITE_URL=https://example.com
